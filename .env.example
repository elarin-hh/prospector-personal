# === Credenciais Instagram ===
IG_USERNAME=seu_usuario
IG_PASSWORD=sua_senha

# === Modo do navegador ===
# true = sem janela visível, false = mostra o navegador
HEADLESS=false

# === Configurações de Prospecção ===
# Academias para buscar (separadas por vírgula)
SEED_ACCOUNTS=academia,crossfit,smartfit

# Hashtags de busca (separadas por vírgula)
SEARCH_HASHTAGS=personaltrainer,personaltrainerbrasil,treinopersonal

# === Filtros de Qualificação ===
MIN_FOLLOWERS=2000
MAX_FOLLOWERS=50000

# === Rate Limiting (segundos) ===
DELAY_MIN=3
DELAY_MAX=8
