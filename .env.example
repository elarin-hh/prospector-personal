# === Credenciais Instagram ===
IG_USERNAME=seu_usuario
IG_PASSWORD=sua_senha

# === Modo do navegador ===
# true = sem janela visível, false = mostra o navegador
HEADLESS=false

# === Configurações de Prospecção ===
# Academias para buscar (separadas por vírgula)
SEED_ACCOUNTS=academia,crossfit,smartfit

# Hashtags de busca (separadas por vírgula)
SEARCH_HASHTAGS=personaltrainer,personaltrainerbrasil,treinopersonal

# === Filtros de Qualificação ===
MIN_FOLLOWERS=2000
MAX_FOLLOWERS=50000

# === Rate Limiting (segundos) ===
DELAY_MIN=3
DELAY_MAX=8

# === Supabase (banco de leads compartilhado) ===
# Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Use a SERVICE ROLE KEY: a tabela leads tem RLS habilitado sem policy
# pública, então a chave anon NÃO consegue ler nem gravar.
SUPABASE_SERVICE_KEY=

# Nome da tabela (padrão: leads)
SUPABASE_TABLE=leads

# true = envia cada lead pro Supabase durante a prospecção
# false = grava só no SQLite e você sincroniza depois pelo menu [13]
SUPABASE_SYNC=true

# Timeout das chamadas ao Supabase (segundos)
SUPABASE_TIMEOUT=15

# === Localização ===
# Cidade atribuída aos leads quando a bio não revela a localização.
# Deixe vazio para gravar sem cidade ("não identificada").
# Aceita "Curitiba", "Curitiba - PR", "floripa", "bh"...
DEFAULT_CITY=
